# ── Model Paths ────────────────────────────────────────────────────────────────
LLAMA_MODEL_PATH=sft/dobby-style-lora/final
QWEN_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
QWEN_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-8B
