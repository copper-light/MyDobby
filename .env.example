# ── Retrieval Tuning (optional) ────────────────────────────────────────────────
# RETRIEVE_TOPK=30
# RERANK_TOPK=5
# SCORE_THRESHOLD=0.15
# RANK_SCORE_THRESHOLD=0.1

# ── Chunking (optional) ────────────────────────────────────────────────────────
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50

# ── BM25 (optional) ────────────────────────────────────────────────────────────
# BM25_K1=1.2
# BM25_B=0.75
