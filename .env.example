# ── API Keys & Tokens ──────────────────────────────────────────────────────────
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SECRET_KEY=
NOTION_TOKEN=
API_KEY=handh
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Service URLs ───────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
MONGO_URL=mongodb://root:password@localhost:27017/
MONGO_DB_NAME=mydobby
